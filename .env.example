# Optional. With neither key, the guided desk still runs every tool.
# Primary model when set: Groq, free tier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback model when Groq is missing or errors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Channel adapters. The demo verify token is northwind-demo when these are empty.
# Outbound Graph API calls are skipped unless the send tokens are set.
WHATSAPP_VERIFY_TOKEN=northwind-demo
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_VERIFY_TOKEN=northwind-demo
MESSENGER_PAGE_TOKEN=
